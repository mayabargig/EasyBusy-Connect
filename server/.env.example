@'
PORT=5000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/easybusy_connect
JWT_SECRET=replace-with-a-private-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=replace-with-a-local-demo-password
'@ | Set-Content -Path "server\.env.example" -Encoding ascii